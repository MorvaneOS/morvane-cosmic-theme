# Maintainer: Clove Twilight <clove@doughmination.gay>
#
# The MorvaneOS look for Cosmic. Everything installed is generated by tools/build.py
# (with Cosmic's own theme code, see README) and committed, so building the package
# needs nothing but the repo.

pkgname=morvane-cosmic-theme
pkgver=1.0.0
pkgrel=1
pkgdesc='MorvaneOS look for Cosmic: theme, icons and wallpaper by default'
arch=(any)
url='https://github.com/MorvaneOS/morvane-cosmic-theme'
license=(LGPL-2.1-or-later)
depends=(
  morvane-gtk-theme   # GTK apps, icons, cursor
  morvane-wallpapers
)

package() {
  # Found before Cosmic's own defaults in /usr/share/cosmic (see README)
  install -d "$pkgdir/usr/share/morvaneos"
  cp -r "$startdir"/data/cosmic "$pkgdir/usr/share/morvaneos/"
  install -Dm644 "$startdir"/profile.d/morvane-cosmic-theme.sh -t "$pkgdir/etc/profile.d/"
  find "$pkgdir/usr/share" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
}
